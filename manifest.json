{
  "manifest_version": 3,
  "name": "Car Notes",
  "version": "1.0.0",
  "description": "Add colored notes to car listings on mobile.de and otomoto.pl",
  "permissions": ["storage", "scripting"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline';"
  },
  "host_permissions": [
    "https://mobile.de/*",
    "https://www.mobile.de/*",
    "https://otomoto.pl/*",
    "https://www.otomoto.pl/*",
    "https://*.mobile.de/*",
    "https://*.otomoto.pl/*",
    "https://cdn.jsdelivr.net/*",
    "https://*.supabase.co/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "options_page": "src/popup/options.html",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Car Notes"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mobile.de/*",
        "https://www.mobile.de/*",
        "https://otomoto.pl/*",
        "https://www.otomoto.pl/*",
        "https://*.mobile.de/*",
        "https://*.otomoto.pl/*"
      ],
      "js": ["src/content/utils.js", "src/content/vehicle-extractor-simple.js", "src/content/features-parser.js", "src/content/feature-column-mapper.js", "src/content/features-manager.js", "src/content/unified-panel.js", "src/content/extraction-ui.js", "src/content/features-display.js", "src/content/router.js", "src/content/handlers.js", "src/content/sites/mobile-de.js", "src/content/sites/otomoto.js", "src/content/content.js"],
      "css": ["src/styles/content.css"],
      "run_at": "document_idle"
    }
  ]
}


